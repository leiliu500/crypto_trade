# Credentials and endpoint safety controls stay environment-only.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Standard Alpaca aliases are also accepted:
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
ALPACA_PAPER=true

# Tunable defaults and the enabled symbol list are loaded from base.json.
# Each symbol gets an overlay named from the normalized symbol, such as
# btc_usd.json or link_usd.json.
CONFIG_DIR=config

# shadow: decisions only; paper: paper account orders; live: real-money orders;
# record: market-data JSONL only; replay: local event replay.
TRADING_MODE=shadow

# Paper-only strategy exercise. Uses zero simulated execution fees/reserves and
# caps per-symbol notional at $25. Never enable for performance evaluation.
PAPER_ENTRY_EXERCISE=false

# Optional finite-risk bearish route. A qualifying BTC/USD or ETH/USD short
# intent buys a same-day put on IBIT or ETHA. It is disabled by default and
# requires Alpaca options level 2. Market prices come from Alpaca WebSockets.
CRYPTO_SHORT_OPTIONS_ENABLED=false

# Live mode additionally requires both values below exactly as shown.
ALLOW_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=
# Required in addition to the normal live interlocks when 0DTE routing is on:
OPTIONS_SHORT_LIVE_CONFIRMATION=

# Database connection/deployment values stay here. Database behavior and queue
# tunables are configured in config/base.json.
# Docker Compose connects the engine to PostgreSQL using the values below.
# For a non-Docker engine, optionally set DATABASE_URL explicitly.
# DATABASE_URL=postgresql://crypto_trade:crypto_trade_dev@127.0.0.1:5433/crypto_trade
POSTGRES_DB=crypto_trade
POSTGRES_USER=crypto_trade
POSTGRES_PASSWORD=crypto_trade_dev
POSTGRES_PORT=5433
