# Kraken Futures paper mode uses the production public WebSocket feed but keeps
# every order and position inside this process.
TRADING_VENUE=kraken_futures
KRAKEN_FUTURES_WEBSOCKET_URL=wss://futures.kraken.com/ws/v1
KRAKEN_FUTURES_SYMBOL_MAP_JSON={"BTC/USD":"PF_XBTUSD","ETH/USD":"PF_ETHUSD"}
KRAKEN_PAPER_INITIAL_EQUITY=100000
KRAKEN_PAPER_STATE_FILE=data/kraken-paper-state.json
# Base-tier defaults; override these when your applicable fee tier differs.
KRAKEN_FUTURES_MAKER_FEE_BPS=2
KRAKEN_FUTURES_TAKER_FEE_BPS=5
# Static reserve only; the local simulator does not claim exact funding parity.
KRAKEN_FUTURES_FUNDING_RESERVE_BPS=0

# Tunable defaults and the enabled symbol list are loaded from base.json.
# Versioned limits and DATABASE_REQUIRED live there, not in environment overrides.
# Inspect the resolved settings with npm run config:audit (no credentials printed).
# Each symbol gets an overlay named from the normalized symbol, such as
# btc_usd.json or link_usd.json.
CONFIG_DIR=config

# shadow: decisions only; paper: local simulated orders;
# record: market-data JSONL only; replay: local event replay.
TRADING_MODE=shadow

# Futures monitoring: both model engines are disabled. MODEL_ONLY_ENTRIES=true
# also blocks legacy entries; existing position exits remain active.
POLICY_ENGINE_ENABLED=false
# Distribution research and checkpoint files are retained for offline analysis.
DISTRIBUTIONAL_ENGINE_ENABLED=false
# RISK_BOUNDED uses config/base.json: $1,000 maximum and 1% of current equity.
# LEGACY_FIXED is available only to reproduce the original $12 experiments.
DISTRIBUTIONAL_SIZING_MODE=RISK_BOUNDED
DISTRIBUTIONAL_PAPER_ENTRIES_ENABLED=false
# Optional unvalidated paper experiment: 3 training dates; positive-score and risk checks remain.
DISTRIBUTIONAL_PAPER_TRIAL_ENABLED=false
# Independent 6/16/31-minute training clocks; requires paper trial mode.
DISTRIBUTIONAL_EFFICIENT_TRAINING_ENABLED=false
# Learned market partitions; separate experimental predictor, same entry/risk gates.
# Requires the efficient paper trial and preserves its historical labels.
DISTRIBUTIONAL_REGIME_MODEL_ENABLED=false
DISTRIBUTIONAL_STATE_FILE=data/distributional-state.json
# Risk-bounded training adds a sizing-policy hash to this base path.
# Changing the policy starts a separate bank; original $12 evidence is preserved.
# Recent observed prices survive deployment; fresh books and 30s flow are still required.
DISTRIBUTIONAL_HISTORY_FILE=data/distributional-state.json.market.json
# Optional immutable artifact from research:distribution:train, imported before startup.
DISTRIBUTIONAL_TRAINING_FILE=
# The following permissions apply to the older engine when the replacement is off.
# Allows qualifying joint BTC/ETH forecasts to submit capped orders in paper mode.
CROSS_ASSET_PAPER_ENTRIES_ENABLED=false
# Only model forecasts may create entries; existing position exits remain active.
MODEL_ONLY_ENTRIES=true
# Require the model cost/uncertainty screen for orders. Rejected directions
# continue in separate shadow research. true explicitly enables evaluation orders.
CROSS_ASSET_PAPER_EVALUATION_ENABLED=false

# Paper-only strategy exercise. Uses zero simulated execution fees/reserves and
# caps per-symbol notional at $25. Never enable for performance evaluation.
PAPER_ENTRY_EXERCISE=false

# Database connection/deployment values stay here. Database behavior and queue
# tunables are configured in config/base.json.
# Docker Compose connects the engine to PostgreSQL using the values below.
# For a non-Docker engine, optionally set DATABASE_URL explicitly.
# DATABASE_URL=postgresql://crypto_trade:crypto_trade_dev@127.0.0.1:5433/crypto_trade
POSTGRES_DB=crypto_trade
POSTGRES_USER=crypto_trade
POSTGRES_PASSWORD=crypto_trade_dev
POSTGRES_PORT=5433
