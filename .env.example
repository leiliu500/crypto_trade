# Alpaca credentials. Start with paper keys and ALPACA_PAPER=true.
ALPACA_API_KEY=
ALPACA_API_SECRET=
# Standard Alpaca aliases are also accepted:
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
ALPACA_PAPER=true

# Deterministic rules are the default entry source. No MODEL_CONFIG_JSON is
# loaded in this mode. ENTRY_MODE=rules remains accepted as a legacy alias.
SIGNAL_MODE=DETERMINISTIC_ONLY
DETERMINISTIC_CONFIG_VERSION=deterministic-v1

# Causal deterministic feature windows.
RULE_IMPULSE_WINDOW_MS=500
RULE_BREAKOUT_WINDOW_MS=2000
RULE_ANCHOR_WINDOW_MS=5000
RULE_FLIP_WINDOW_MS=2000
RULE_MAX_STORED_WINDOW_MS=10000
RULE_CUSUM_DRIFT=0.15
RULE_CUSUM_CAP=12
RULE_ALIGNMENT_DEADBAND=0.2

# Health, liquidity, and deterministic regime gates.
RULE_MAX_PROVIDER_AGE_MS=250
MAX_PROVIDER_FUTURE_SKEW_MS=100
RULE_REGIME_MAX_SPREAD_BPS=30
RULE_MAX_SPREAD_BPS=30
RULE_MAX_SPREAD_Z=3
RULE_MIN_DEPTH_Z=-2.5
RULE_MIN_DEPTH_NOTIONAL=50000
RULE_MAX_IMPACT_BPS=1.5
RULE_LIQUIDITY_STRESS_SPREAD_Z=4
RULE_LIQUIDITY_STRESS_DEPTH_Z=4
RULE_TREND_EFFICIENCY=0.6
RULE_CHOP_EFFICIENCY=0.35
RULE_MAX_TREND_FLIP_RATE=0.3
RULE_CHOP_FLIP_RATE=0.55
RULE_REGIME_RESET_RATIO=0.75
RULE_REGIME_MICRO_EDGE_BPS=0.15
RULE_REGIME_QIK=0.1
RULE_REGIME_OFI=0.25
RULE_REGIME_TFI=0.12
RULE_REGIME_VELOCITY_Z=0.2
RULE_REGIME_MAX_OPPOSING_ACCELERATION_Z=0.35
RULE_REGIME_BREAKOUT_BPS=0.5
RULE_REGIME_BREAKOUT_CUSUM=2.5
RULE_REGIME_BREAKOUT_OFI=0.35
RULE_REGIME_BREAKOUT_TFI=0.18
RULE_REGIME_NEUTRAL_OFI=0.08
RULE_REGIME_NEUTRAL_TFI=0.05

# Independent book, flow, kinematic, and quality evidence.
RULE_MICRO_EDGE_BPS=0.2
RULE_QI1=0.15
RULE_QIK=0.1
RULE_OFI=0.3
RULE_TFI=0.15
RULE_REPLENISHMENT=0.1
RULE_VELOCITY_Z=0.25
RULE_MAX_OPPOSING_ACCELERATION_Z=0.3
RULE_IMPULSE_BPS=0.4
RULE_BREAKOUT_BPS=0.5
RULE_CUSUM=2.5
RULE_EFFICIENCY=0.6
RULE_MAX_FLIP_RATE=0.3
RULE_MIN_BOOK_VOTES=2
RULE_MIN_FLOW_VOTES=2
RULE_MIN_KINEMATIC_VOTES=2
RULE_WEIGHT_MICRO=1
RULE_WEIGHT_QI1=1
RULE_WEIGHT_QIK=1
RULE_WEIGHT_OFI=1.25
RULE_WEIGHT_TFI=1.25
RULE_WEIGHT_REPLENISHMENT=0.5
RULE_WEIGHT_VELOCITY=1
RULE_WEIGHT_ACCELERATION=0.5
RULE_WEIGHT_IMPULSE=0.75
RULE_WEIGHT_CUSUM=0.75
RULE_WEIGHT_EFFICIENCY=0.75
RULE_WEIGHT_FLIP_QUALITY=0.75

# Score hysteresis, event-time persistence, arbitration, and one-fire reset.
RULE_SCORE_ENTER=0.45
RULE_SCORE_RESET=0.15
RULE_ARBITRATION_MARGIN=0.2
RULE_PERSISTENCE_WINDOW_MS=250
RULE_MIN_PERSISTENCE=0.75
RULE_MIN_CONFIRMATION_MS=100
RULE_MIN_CONFIRMATION_EVENTS=4
RULE_COOLDOWN_MS=3000
RULE_RESET_MS=250

# Anti-chasing and deterministic opportunity-versus-cost gate.
RULE_MAX_IMPULSE_Z=2.5
RULE_MAX_CHASE_BPS=1.5
RULE_MAX_ANCHOR_Z=3
RULE_EXPECTED_LATENCY_MS=100
RULE_HOLD_HORIZON_MS=1000
RULE_DECAY_TAU_MS=750
RULE_KINEMATIC_SIGMA_CAP=1.5
RULE_FLOW_SIGMA_SCALE=0.75
RULE_IMPULSE_SIGMA_CAP=1.25
RULE_TOTAL_SIGMA_CAP=2
RULE_OPPORTUNITY_WEIGHT_MICRO=0.15
RULE_OPPORTUNITY_WEIGHT_KINEMATIC=0.35
RULE_OPPORTUNITY_WEIGHT_FLOW=0.3
RULE_OPPORTUNITY_WEIGHT_IMPULSE=0.2
RULE_EFFICIENCY_EXPONENT=1
RULE_PERSISTENCE_EXPONENT=1
RULE_DISAGREEMENT_PENALTY=0.75
RULE_LATENCY_VOLATILITY_PENALTY=0.5
RULE_SPREAD_STRESS_PENALTY_BPS=0.2
RULE_FLIP_PENALTY_BPS=0.5
RULE_OPPOSING_ACCELERATION_PENALTY_BPS=0.25
COST_SAFETY_FACTOR=1.75
RULE_MIN_NET_EDGE_BPS=0.5
RULE_FULL_QUALITY_EDGE_BPS=3

# Deterministic continuation/reversal exit evidence.
RULE_MIN_CONTINUATION_SCORE=0.05
RULE_REVERSAL_VOTE_THRESHOLD=3
RULE_HOLD_KINEMATIC_SIGMA_CAP=1.5
RULE_HOLD_FLOW_SIGMA_SCALE=0.75
RULE_HOLD_TOTAL_SIGMA_CAP=2
RULE_REVERSAL_ACCELERATION_Z=0.5
RULE_REVERSAL_OFI=0.3
RULE_REVERSAL_TFI=0.15
RULE_REVERSAL_REPLENISHMENT=0.1
RULE_REVERSAL_CUSUM=2.5
RULE_HOLD_SPREAD_PENALTY_BPS=0.2
RULE_HOLD_FLIP_PENALTY_BPS=0.5
RULE_MIN_HOLD_EDGE_BPS=0

# shadow: decisions only; paper: paper account orders; live: real-money orders;
# record: market-data JSONL only; replay: local event replay.
TRADING_MODE=paper
SYMBOLS=BTC/USD,LINK/USD
ALPACA_CRYPTO_LOCATION=us

# Live mode additionally requires both values below exactly as shown.
ALLOW_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

REPLAY_FILE=data/events.jsonl
RECORD_FILE=data/events.jsonl

# Operations dashboard (loopback-only by default).
DASHBOARD_ENABLED=true
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787

# PostgreSQL telemetry. Docker Compose uses the POSTGRES_* values; the app uses
# DATABASE_URL when present, otherwise it builds the same local URL.
DATABASE_ENABLED=true
DATABASE_REQUIRED=false
DATABASE_URL=postgresql://crypto_trade:crypto_trade_dev@127.0.0.1:5433/crypto_trade
POSTGRES_DB=crypto_trade
POSTGRES_USER=crypto_trade
POSTGRES_PASSWORD=crypto_trade_dev
POSTGRES_PORT=5433
DATABASE_FLUSH_INTERVAL_MS=250
DATABASE_MAX_QUEUE=10000
DATABASE_MARKET_SAMPLE_MS=1000
