{
  "name": "multi-venue-minimal-latency-crypto-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Event-driven TypeScript crypto trading engine with Kraken Futures paper trading and Alpaca adapters.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "start": "tsx src/main.ts",
    "start:production": "node --enable-source-maps dist/src/main.js",
    "shadow": "tsx src/main.ts shadow",
    "paper": "tsx src/main.ts paper",
    "paper:demo-trade": "tsx src/main.ts paper --paper-demo-entry",
    "record": "tsx src/main.ts record",
    "replay": "tsx src/main.ts replay",
    "recall": "tsx src/backtest/opportunity-recall-main.ts",
    "dashboard": "tsx src/dashboard/demo-main.ts",
    "dashboard:demo": "tsx src/dashboard/demo-main.ts",
    "docker:up": "docker-compose up -d --build",
    "docker:logs": "docker-compose logs -f engine",
    "db:migrate": "tsx src/database/migrate-main.ts",
    "db:verify": "tsx src/database/verify-main.ts",
    "db:smoke": "tsx src/database/smoke-main.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "pg": "^8.23.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
